# SQLite URL. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///data/expenses.sqlite3

# Persistent directory for the ChromaDB user_preferences collection.
CHROMA_PERSIST_DIR=data/chroma

# Active chat provider: google or ollama
LLM_PROVIDER=google

# Gemini model used when LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=

# Used when LLM_PROVIDER=ollama. OLLAMA_MODEL is intentionally separate so a
# Gemini name in LLM_MODEL is not sent to the local server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava

# Token from @BotFather. Required only for the Telegram polling bot.
TELEGRAM_BOT_TOKEN=

# LangSmith tracing. Leave the key empty to keep runs local.
# These names are read by LangChain itself once the process loads `.env`.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autonomous-expense-agent
